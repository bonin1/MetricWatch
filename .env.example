# =============================================================================
# MetricWatch Configuration
# Copy to .env: cp .env.example .env  (or run ./start.sh)
# =============================================================================

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_METRICS=system-metrics
KAFKA_TOPIC_SOCIAL=social-text

# Producer intervals (seconds)
METRICS_INTERVAL=5
SOCIAL_INTERVAL=2

# Consumer settings
CONSUMER_BATCH_SIZE=10
CONSUMER_MAX_POLL_INTERVAL=300000

# Sentiment analysis
# keyword     = fast build & startup (recommended)
# transformers = full DistilBERT AI (~2GB download on first build)
SENTIMENT_MODE=keyword
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english

# Anomaly detection (z-score threshold on rolling window)
ANOMALY_DETECTION_ENABLED=true
ANOMALY_ZSCORE_THRESHOLD=3.0

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# MongoDB
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=metricwatch
MONGO_USER=metricwatch
MONGO_PASSWORD=metricwatch123

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=metricwatch
POSTGRES_USER=metricwatch
POSTGRES_PASSWORD=metricwatch123

# Elasticsearch
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# API Gateway
API_PORT=8000

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Logging (text | json)
LOG_FORMAT=json
LOG_LEVEL=INFO
